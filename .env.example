# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요. .env는 GitHub에 올리지 마세요(.gitignore에 포함).
# Supabase 대시보드 > Project Settings > API Keys 에서 확인할 수 있습니다.
# Render에 배포할 때는 이 파일 대신 Render 대시보드 > Environment 에 같은 이름으로 넣습니다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 공개용 키(sb_publishable_... 또는 anon). 로그인에만 쓰이며 브라우저에도 전달됩니다.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 비밀키(sb_secret_... 또는 service_role). 절대 공유·커밋 금지.
SUPABASE_SECRET_KEY=sb_secret_xxx
# API 서버 포트. npm run dev의 Vite가 이 포트로 /api를 전달합니다(vite.config.js와 맞춰야 함). Render에서는 자동으로 정해짐.
PORT=4173
# 접속 받을 주소. 비우면 내 컴퓨터만(127.0.0.1). Render에서는 자동으로 0.0.0.0.
# HOST=127.0.0.1

# 로그인 방식: dev = 점검용(로그인 없음) / jwt = 실제 로그인. 비워 두면 jwt.
AUTH_MODE=dev
# dev 모드에서 작업자로 기록될 Supabase Auth 사용자 UUID (Authentication > Users에서 복사)
# 이 사용자에게 user_store_access로 지점 권한(editor)을 줘야 조회·정정·예측 실행이 됩니다.
DEV_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000
